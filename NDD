#  MIDI Diatonic Analyzer  (Google Colab)
#  One key  ->  multiple MIDI files  ->  a result for EACH file
#  Drum notes (General MIDI channel 10) are excluded.
# =========================================================

!pip install mido --quiet

import mido
from google.colab import files

# --- key handling -----------------------------------------

NOTE_TO_PITCH_CLASS = {
    'C': 0,  'B#': 0,
    'C#': 1, 'DB': 1,
    'D': 2,
    'D#': 3, 'EB': 3,
    'E': 4,  'FB': 4,
    'F': 5,  'E#': 5,
    'F#': 6, 'GB': 6,
    'G': 7,
    'G#': 8, 'AB': 8,
    'A': 9,
    'A#': 10, 'BB': 10,
    'B': 11, 'CB': 11,
}

MAJOR_SCALE_STEPS = (0, 2, 4, 5, 7, 9, 11)   # W-W-H-W-W-W-H
PITCH_CLASS_NAMES = ['C', 'C#/Db', 'D', 'D#/Eb', 'E', 'F',
                     'F#/Gb', 'G', 'G#/Ab', 'A', 'A#/Bb', 'B']

def parse_key(text):
    """Accepts C, c#, Db, C#/Db, bb, etc. -> pitch class 0-11."""
    token = text.strip().split('/')[0].strip().upper()
    if token not in NOTE_TO_PITCH_CLASS:
        raise ValueError(f"'{text}' is not a recognised key.")
    return NOTE_TO_PITCH_CLASS[token]

# --- analysis ---------------------------------------------

DRUM_CHANNEL = 9   # mido is 0-based, so this = General MIDI channel 10

def analyse_file(path, diatonic_pcs):
    """Returns (total_notes, diatonic, non_diatonic, drum_notes_skipped)."""
    mid = mido.MidiFile(path)
    total = diatonic = drums = 0
    for track in mid.tracks:
        for msg in track:
            if msg.type == 'note_on' and msg.velocity > 0:
                if msg.channel == DRUM_CHANNEL:
                    drums += 1            # drum hit -> ignore
                    continue
                total += 1
                if msg.note % 12 in diatonic_pcs:
                    diatonic += 1
    return total, diatonic, total - diatonic, drums

def non_diatonic_percent(non_diatonic, total):
    """% non-diatonic, rounded DOWN to one decimal (2/15 -> 13.3)."""
    return (non_diatonic * 1000 // total) / 10

# --- run --------------------------------------------------

while True:
    try:
        key_pc = parse_key(input("Major key (e.g. C, F#, Bb, C#/Db): "))
        break
    except ValueError as err:
        print(err, "Try: C  C#/Db  D  D#/Eb  E  F  F#/Gb  G  G#/Ab  A  A#/Bb  B")

diatonic_pcs = {(key_pc + step) % 12 for step in MAJOR_SCALE_STEPS}
scale_display = ', '.join(PITCH_CLASS_NAMES[(key_pc + s) % 12]
                          for s in MAJOR_SCALE_STEPS)

print(f"\nKey: {PITCH_CLASS_NAMES[key_pc]} major")
print(f"Diatonic notes: {scale_display}")

print("\nSelect ALL the MIDI files you want to analyse in the picker")
print("(hold Ctrl / Cmd or Shift to select more than one).\n")
uploaded = files.upload()

results = []
for name in uploaded:
    print(f"\n=== {name} ===")
    try:
        total, dia, non_dia, drums = analyse_file(name, diatonic_pcs)
    except Exception as err:
        print(f"  Skipped - could not read this file ({err})")
        continue

    if drums:
        print(f"  Drum notes removed: {drums}")
    if total == 0:
        print("  No pitched notes found (drums-only file?) - nothing to analyse.")
        continue

    pct = non_diatonic_percent(non_dia, total)
    print(f"  Notes analysed:  {total}")
    print(f"  Diatonic:        {dia}")
    print(f"  Non-diatonic:    {non_dia}")
    print(f"  >>> {pct:.1f}% non-diatonic")
    results.append((name, total, non_dia, pct))

if len(results) > 1:
    print("\n" + "=" * 58)
    print(f"SUMMARY  (key of {PITCH_CLASS_NAMES[key_pc]} major)")
    print("-" * 58)
    print(f"{'File':<34}{'Notes':>7}{'Non-diatonic':>16}")
    for name, total, non_dia, pct in results:
        shown = name if len(name) <= 32 else name[:29] + '...'
        print(f"{shown:<34}{total:>7}{pct:>15.1f}%")
